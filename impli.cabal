cabal-version: 3.12
name: impli
version: 6.0.0.0
build-type: Simple
license: MIT
license-file: LICENSE.md
author: Basil Feitknecht
maintainer: bfeitknecht@ethz.ch
homepage: https://github.com/bfeitknecht/impli
bug-reports: https://github.com/bfeitknecht/impli/issues
category: Language
synopsis: Interpreter for an imperative toy language
description:
  Minimal imperative language interpreter built for educational purposes.

extra-doc-files:
  CHANGELOG.md
  README.md
  docs/IMP.ebnf

extra-source-files:
  docs/IMP.ebnf
  docs/examples/*.imp
  docs/man/impli.1
  docs/paper/IMP.pdf

source-repository head
  type: git
  location: https://github.com/bfeitknecht/impli.git

common dependencies
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wextra
    -fexpose-all-unfoldings
    -fspecialise-aggressively

  build-depends:
    base >=4.14 && <5,
    containers >=0.6 && <0.9,
    mtl >=2.2 && <3,
    parsec >=3.1 && <3.2,
    prettyprinter >=1.7 && <2,
    random >=1.1 && <1.3,
    transformers >=0.5 && <0.7,

library
  import: dependencies
  hs-source-dirs: src
  exposed-modules:
    IMP.Check
    IMP.Effect
    IMP.Exception
    IMP.Expression
    IMP.Interpret
    IMP.Lexer
    IMP.Parser
    IMP.Pretty
    IMP.Semantics.Natural
    IMP.Semantics.Structural
    IMP.State
    IMP.Syntax
    REPL.Command
    REPL.Core
    REPL.Input
    REPL.Session
  other-modules:
    Paths_impli
  autogen-modules:
    Paths_impli

common native
  build-depends:
    ansi-terminal >=0.11 && <1.1,
    haskeline >=0.8 && <0.9,
    impli,
    optparse-applicative >=0.15 && <0.19,

common browser
  build-depends:
    ghc-experimental,
    impli,

executable impli
  import: dependencies, native
  hs-source-dirs: app
  main-is: Frontend/Native/Main.hs
  other-modules:
    Frontend.Native.CLI
    Frontend.Native.REPL

  if arch(wasm32)
    buildable: False

executable impli-web
  import: dependencies, browser
  hs-source-dirs: app
  main-is: Frontend/Web/Main.hs
  ghc-options:
    -no-hs-main
    -optl-mexec-model=reactor
    "-optl-Wl,--export=boot"
    "-optl-Wl,--export=submit"
    "-optl-Wl,--export=complete"
    "-optl-Wl,--export=incomplete"
    "-optl-Wl,--export=prompt"

  if !arch(wasm32)
    buildable: False

test-suite impli-test
  import: dependencies
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    impli,
    QuickCheck >=2.14 && <2.17,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.10 && <0.12,
