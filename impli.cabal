cabal-version: 3.12
name: impli
version: 6.0.0.0
build-type: Simple
license: MIT
license-file: LICENSE.md
author: Basil Feitknecht
maintainer: bfeitknecht@ethz.ch
homepage: https://github.com/bfeitknecht/impli
bug-reports: https://github.com/bfeitknecht/impli/issues
category: Language
synopsis: Interpreter for an imperative toy language
description:
  Minimal imperative language interpreter built for educational purposes.

extra-doc-files:
  CHANGELOG.md
  README.md
  docs/IMP.ebnf

extra-source-files:
  docs/IMP.ebnf
  docs/examples/*.imp
  docs/man/impli.1
  docs/paper/IMP.pdf

source-repository head
  type: git
  location: https://github.com/bfeitknecht/impli.git

common dependencies
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wextra

  build-depends:
    base >=4.14 && <5,
    containers >=0.6 && <0.9,
    mtl >=2.2 && <3,
    parsec >=3.1 && <3.2,
    prettyprinter >=1.7 && <2,
    random >=1.1 && <1.3,
    transformers >=0.5 && <0.7,

library
  import: dependencies
  hs-source-dirs: src
  -- cabal-gild: discover src --include=src/IMP/** --exclude=src/IMP/JSON.hs
  exposed-modules:
    IMP.Engine
    IMP.Exception
    IMP.Expression
    IMP.Freer
    IMP.Kernel
    IMP.Lexer
    IMP.Parser
    IMP.Pretty
    IMP.Semantics.Natural
    IMP.Semantics.Structural
    IMP.State
    IMP.Syntax

common native
  build-depends:
    ansi-terminal >=0.11 && <1.1,
    exceptions >=0.10 && <0.11,
    haskeline >=0.8 && <0.9,
    impli,
    optparse-applicative >=0.15 && <0.19,

common browser
  build-depends:
    aeson >=2.2 && <2.3,
    bytestring >=0.10 && <0.13,
    ghc-experimental,
    impli,
    text >=1.2 && <2.2,

executable impli
  import: dependencies, native
  hs-source-dirs: src
  main-is: Frontend/Native/Main.hs
  other-modules:
    Frontend.Native.CLI
    Frontend.Native.Meta
    Frontend.Native.REPL
    Paths_impli
  autogen-modules:
    Paths_impli

executable impli-web
  import: dependencies, browser
  hs-source-dirs: src
  main-is: Frontend/Web/Main.hs
  other-modules:
    IMP.JSON
    Paths_impli
  autogen-modules:
    Paths_impli

  ghc-options:
    -no-hs-main
    -optl-mexec-model=reactor
    "-optl-Wl,--export=start"
    "-optl-Wl,--export=evaluate"
    "-optl-Wl,--export=resolveInput"
    "-optl-Wl,--export=resolveChoice"
    "-optl-Wl,--export=resolveHavoc"
    "-optl-Wl,--export=interrupt"
    "-optl-Wl,--export=getPrompt"
    "-optl-Wl,--export=helpText"
    "-optl-Wl,--export=versionText"
    "-optl-Wl,--export=showState"
    "-optl-Wl,--export=showTrace"
    "-optl-Wl,--export=showSteps"
    "-optl-Wl,--export=parseAst"
    "-optl-Wl,--export=resetSession"

test-suite impli-test
  import: dependencies
  type: exitcode-stdio-1.0
  hs-source-dirs: test src
  main-is: Spec.hs
  other-modules:
    Frontend.Native.Meta
    IMP.Engine
    IMP.Exception
    IMP.Expression
    IMP.Freer
    IMP.Kernel
    IMP.Lexer
    IMP.Parser
    IMP.Pretty
    IMP.Semantics.Natural
    IMP.Semantics.Structural
    IMP.State
    IMP.Syntax
    Paths_impli
  autogen-modules:
    Paths_impli
  build-depends:
    tasty >=1.4 && <1.5,
    tasty-hunit >=0.10 && <0.11,
