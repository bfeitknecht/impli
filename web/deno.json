{
  "tasks": {
    "build": "deno run --allow-read --allow-write --unstable-bundle build.ts",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1.0.13/file-server public",
    "smoke": "deno run --allow-read test/smoke.ts"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns", "esnext"]
  },
  "lint": {
    "rules": { "exclude": ["no-explicit-any"] }
  },
  "imports": {
    "@/": "./src/",
    "ghostty-web": "npm:ghostty-web@^0.4.0",
    "@runno/wasi": "npm:@runno/wasi@^0.10.0",
    "stub": "./public/stub.js",
    "examples": "./public/examples.js"
  }
}
